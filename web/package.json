{
  "name": "agentchat-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:post": "node scripts/dev-post.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-info.mjs && npm run typecheck && vite build && node scripts/assets.mjs",
    "test": "node --test tests/unit/*.test.ts && npm run test:react",
    "test:dev": "node --test --test-concurrency=1 tests/dev/*.test.ts",
    "test:integration": "node --test tests/integration/*.test.ts",
    "test:browser": "playwright test",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "graphql-codegen --config codegen.ts --check",
    "test:react": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@apollo/client": "4.3.5",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@hookform/resolvers": "6.0.2",
    "@tanstack/react-virtual": "3.14.24",
    "graphql": "16.14.2",
    "jdenticon": "3.3.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-router": "8.5.1",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/typescript-generic-sdk": "5.0.1",
    "@graphql-codegen/typescript-operations": "6.2.0",
    "@graphql-tools/graphql-file-loader": "9.1.0",
    "@graphql-tools/load": "9.1.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@graphql-codegen/typescript-generic-sdk": {
      "@graphql-tools/utils": "12.1.0"
    }
  }
}
